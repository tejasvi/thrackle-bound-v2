+/* init filter bitsets (depth 0) from the current complete state of edges 0..L-1 */
+static int filters_init_state(int L) {
+    for (int i = 0; i < nfl; i++) {
+        Filter *F = &FL[i];
+        uint64_t *c = F->cur;
+        memset(c, 0, sizeof(uint64_t) * F->W);
+        for (int s2 = 0; s2 < F->nsys; s2++) c[s2 >> 6] |= 1ULL << (s2 & 63);
+        for (int e = 0; e < L; e++) {
+            int a = F->inH[e];
+            if (a < 0) continue;
+            int prev = -1;
+            for (int t = 0; t < len[e]; t++) {
+                int x = F->inH[row[e][t]];
+                if (x < 0) continue;
+                if (prev >= 0) { uint64_t *p = P_(F, a, prev, x); for (int w = 0; w < F->W; w++) c[w] &= p[w]; }
+                prev = x;
+            }
+        }
+        int nd = 0;
+        for (int w = 0; w < F->W; w++) if (c[w]) F->act[nd++] = w;
+        F->nact[0] = nd;
+        if (!nd) return 0;
     }
     return 1;
 }
